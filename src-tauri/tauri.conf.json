{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "patchbay",
  "version": "0.1.5",
  "identifier": "dev.patchbay.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "patchbay",
        "width": 940,
        "height": 620,
        "minWidth": 640,
        "minHeight": 380,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "copyright": "© 2026 pyvno",
    "publisher": "pyvno",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "../assets/dmg-background.tiff",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 176, "y": 190 },
        "applicationFolderPosition": { "x": 484, "y": 190 }
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["patchbay"] }
    },
    "updater": {
      "endpoints": ["https://github.com/pyvnoaim/patchbay/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwOUQyMDE1OTgxMkJCRQpSV1MrSzRGWkFkSUpCOTdlZ0UzYlFhUzBEKy9sY2htZHQ5SWZJYTNmMmV3OG9vSzRTUnl4V1lTbAo="
    }
  }
}
