{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "patchbay",
  "version": "0.0.1",
  "identifier": "dev.patchbay.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "patchbay",
        "width": 940,
        "height": 620,
        "minWidth": 560,
        "minHeight": 380,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
