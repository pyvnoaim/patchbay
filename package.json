{
  "name": "patchbay",
  "version": "0.0.1",
  "description": "Every host, one jack away.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bay": "src/cli.ts"
  },
  "engines": {
    "node": ">=22.6"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/dev.mjs build",
    "cli": "node scripts/dev.mjs cli",
    "test": "npm run test:cli && npm run test:app && npm run test:server",
    "test:cli": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test",
    "test:app": "node scripts/dev.mjs cargo test --manifest-path src-tauri/Cargo.toml",
    "test:server": "node scripts/dev.mjs cargo test --manifest-path server/Cargo.toml",
    "server": "node scripts/dev.mjs cargo run --manifest-path server/Cargo.toml",
    "icon": "node scripts/icon.mjs && tauri icon assets/icon.png",
    "icons": "node scripts/icons.mjs",
    "brands": "node scripts/brands.mjs",
    "vendor": "node scripts/vendor.mjs"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-static": "^1.37.0",
    "simple-icons": "^16.29.0"
  }
}
